rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // 관리자 판별
    // - admin.html은 Firebase Authentication(이메일/비밀번호)으로 로그인합니다.
    // - "로그인한 계정 = 관리자"로 단순화하지 않고, admins/{uid} 문서가 있는
    //   계정만 관리자로 인정합니다(관리자 계정을 여러 개 두거나 실수로 다른
    //   이메일 계정이 생기더라도 안전하도록).
    // - 관리자 계정 생성 절차:
    //   1) Firebase Console > Authentication 에서 이메일/비밀번호로 관리자 계정 생성 (admin.html 로그인용)
    //   2) 그 계정으로 한 번 로그인해서 UID를 확인 (Authentication > Users 목록에서 확인 가능)
    //   3) Firestore Console에서 admins 컬렉션에 해당 UID를 문서 ID로 하는 문서를 만들고,
    //      내용은 예: { role: "admin" } 정도로 채워두면 됩니다. (필드 내용 자체는 규칙에서 보지 않음)
    // ---------------------------------------------------------------
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // 본인이 관리자인지 클라이언트에서 확인할 수 있게 자기 문서만 읽기 허용.
      allow read: if request.auth != null && request.auth.uid == uid;
      // admins 문서는 반드시 Firebase Console(또는 Admin SDK)에서만 만들고 지웁니다.
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // 입학 상담 신청(consultations)
    // - 접수(create)는 클라이언트가 직접 쓰지 않고, functions/index.js 의
    //   createConsultation 을 통해서만 이뤄진다(Admin SDK로 규칙을 우회).
    //   신청 시 받은 취소용 비밀번호(4자리)를 서버에서 해시로 저장해야 하기 때문.
    // - 읽기/수정/삭제는 admins 컬렉션에 등록된 관리자만 가능.
    // - 본인 취소(연락처 + 비밀번호로 찾아서 deleted:true)도 마찬가지로
    //   listMyConsultations / cancelMyConsultations 함수를 통해서만 이뤄진다 —
    //   "연락처로 검색"은 이 규칙만으로는 안전하게 열 수 없기 때문.
    // ---------------------------------------------------------------
    match /consultations/{docId} {
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Q&A 게시판 — 비밀번호 인증은 Cloud Functions(Admin SDK)에서 처리.
    //
    // - qna_questions: 목록/일반 열람용 공개 컬렉션. 비공개 글은
    //   title/body가 애초에 null로 저장되어, 이 컬렉션만 봐서는
    //   비공개 글 내용을 알 수 없음. 클라이언트 직접 쓰기는 막고
    //   (functions/index.js 의 qnaCreateQuestion 등이 Admin SDK로
    //   대신 기록), 관리자의 답변 등록/상태 변경만 여기서 허용.
    // - qna_secrets: 비밀번호 해시 + 비공개 글의 실제 내용을 담는
    //   컬렉션. 클라이언트는 절대 직접 읽거나 쓸 수 없음(항상 false).
    //   관리자는 답변 작성을 위해 비공개 글 원문을 볼 수 있어야 하므로
    //   읽기만 예외적으로 허용.
    // ---------------------------------------------------------------
    match /qna_questions/{docId} {
      // 휴지통(deleted:true)으로 간 글은 관리자만 읽을 수 있다.
      // 공개 화면은 where('deleted','==',false) 조건으로만 목록을 조회한다.
      allow get: if isAdmin() || resource.data.deleted == false;
      allow list: if isAdmin() || resource.data.deleted == false;
      allow create, delete: if isAdmin();
      // 관리자의 답변 등록/상태 변경(update)만 클라이언트에서 직접 허용.
      // 일반 사용자의 작성/수정/삭제는 전부 Cloud Functions를 통해서만
      // 이뤄지며, 그 경로는 Admin SDK를 쓰므로 이 규칙과 무관하게 항상 통과함.
      allow update: if isAdmin();
    }

    // 비공개 글의 관리자 답변(answer)도 여기에만 저장한다(공개 컬렉션에는 answered:true만).
    match /qna_secrets/{docId} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer']);
      allow create: if false;
    }

    // ---------------------------------------------------------------
    // 관리자 푸시 알림용 FCM 토큰(admin_fcm_tokens) — 새 Q&A 질문이
    // 등록되면 onNewQnaQuestion 함수가 여기 저장된 토큰으로 푸시를 보낸다.
    // 문서 ID = 토큰 문자열 자체(중복 등록 자동 방지).
    // ---------------------------------------------------------------
    match /admin_fcm_tokens/{token} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 챗봇 위기 신호 알림(chat_safety_alerts) — 챗봇이 자해·자살 관련
    // 표현을 감지하면 functions/index.js(chatWithAI)가 Admin SDK로
    // 여기에 문서를 만든다(신원 없이 시각 + 유형만 기록). 클라이언트는
    // 절대 직접 만들거나 지울 수 없고, 관리자만 목록을 확인하고
    // "확인함" 처리(update)를 할 수 있다.
    // ---------------------------------------------------------------
    match /chat_safety_alerts/{docId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------
    // 챗봇 질문 점검(chat_unanswered) — 챗봇이 근거를 충분히 찾지 못한 질문을
    // functions/index.js(chatWithAI)가 Admin SDK로 익명 기록한다. 클라이언트는
    // 만들 수 없고, 관리자만 읽기·"처리함" 표시(update)·삭제를 할 수 있다.
    // ---------------------------------------------------------------
    match /chat_unanswered/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ---------------------------------------------------------------
    // 메인 페이지 학교소개 콘텐츠(site_content) — admin.html "학교 소개 관리"
    // 탭에서 편집. 공개 페이지(index.html)에서 누구나 읽어야 하므로 읽기는
    // 열어두고, 쓰기는 관리자만.
    // 문서: greeting(학교장 인사말), curriculum(교육과정), gallery(학교생활 갤러리)
    // ---------------------------------------------------------------
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 그 외 컬렉션(consult_cancel_attempts 포함)은 기본적으로 모두 차단 —
    // 취소 시도 횟수 기록은 Cloud Functions(Admin SDK)만 다룬다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
