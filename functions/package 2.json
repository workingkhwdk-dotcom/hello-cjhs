{
  "name": "cwjh-admission-functions",
  "description": "창원중앙고 입학상담 사이트 - Cloud Functions (챗봇 프록시 / 신청 알림)",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run test:knowledge && npm run test:brochure && npm run test:curriculum && npm run test:course && npm run test:results && npm run test:regulation && npm run test:ratelimit && npm run test:chatlimit && npm run test:unanswered && npm run test:websearch",
    "test:knowledge": "node test/run_knowledge_retrieval_tests.js",
    "test:brochure": "node test/run_brochure_tests.js",
    "test:curriculum": "node test/run_curriculum_tests.js",
    "test:course": "node test/run_course_advice_tests.js",
    "test:results": "node test/run_results_tests.js",
    "test:regulation": "node test/run_regulation_tests.js",
    "test:ratelimit": "node test/run_rate_limit_tests.js",
    "test:chatlimit": "node test/run_chat_limit_tests.js",
    "test:unanswered": "node test/run_unanswered_tests.js",
    "test:websearch": "node test/run_web_search_tests.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "nodemailer": "^6.9.14"
  },
  "private": true
}
